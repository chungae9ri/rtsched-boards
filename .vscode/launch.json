{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "probe-rs-debug",
      "request": "launch",
      "name": "probe_rs Launch (flash)",
      "cwd": "${workspaceFolder}",
      "speed": 100,
      "probe": "1366:0105:000720762184",
      "runtimeExecutable": "probe-rs",
      "runtimeArgs": ["dap-server"],
      "chip": "LPC55S69JBD100",
      //"protocol": "swd",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": true,
        "formatOptions": {
          //!MODIFY (or remove). Valid values are: 'bin', 'hex', 'elf'(default), 'idf'
          "binaryFormat": "elf"
        }
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/lpc55s69",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "String",
              "showTimestamps": false
            }
          ],
        }
      ],
      "env": {
        //"RUST_LOG": "info"
      },
       // Info, Debug
      "consoleLogLevel": "Console"
    },
    {
      "type": "probe-rs-debug",
      "request": "attach",
      "name": "probe_rs Attach (no flash)",
      "cwd": "${workspaceFolder}",
      "speed": 100,
      "probe": "1366:0105:000720762184",
      "runtimeExecutable": "probe-rs",
      "runtimeArgs": ["dap-server"],
      "chip": "LPC55S69JBD100",
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/lpc55s69",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "String",
              "showTimestamps": false
            }
          ]
        }
      ],
      "consoleLogLevel": "Console"
    }
  ]
}
